# ============================================================
# 1. FUNÇÃO PARA CALCULAR A DISTRIBUIÇÃO PONDERADA
# ============================================================

calcular_distribuicao_escala <- function(design, disciplina_nome) {
  
  resultado <- svyby(
    formula = ~escala,
    by = ~raca,
    design = design,
    FUN = svymean,
    na.rm = TRUE,
    keep.names = FALSE
  )
  
  
  resultado %>%
    
    # Manter somente raça e proporções das escalas
    select(
      raca,
      escala1,
      escala2,
      escala3,
      escala4
    ) %>%
    
    # Converter proporções para percentuais
    mutate(
      across(
        .cols = starts_with("escala"),
        .fns = ~ round(.x * 100, digits = 1)
      ),
      
      Disciplina = disciplina_nome,
      
      raca = factor(
        raca,
        levels = c(
          "Branco",
          "Pardo",
          "Preto",
          "Amarela",
          "Indígena",
          "ND"
        )
      )
    ) %>%
    
    # Renomear as colunas
    rename(
      Raca = raca,
      `1 - Insuficiente` = escala1,
      `2 - Básico` = escala2,
      `3 - Proficiente` = escala3,
      `4 - Avançado` = escala4
    ) %>%
    
    select(
      Disciplina,
      Raca,
      `1 - Insuficiente`,
      `2 - Básico`,
      `3 - Proficiente`,
      `4 - Avançado`
    ) %>%
    
    arrange(
      Disciplina,
      Raca
    )
}


