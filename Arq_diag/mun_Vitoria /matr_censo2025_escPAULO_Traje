# ============================================================
# 6. LOCALIZAR UM ARQUIVO DENTRO DO ZIP
# ============================================================

localizar_arquivo_zip <- function(
    caminho_zip,
    nome_procurado
) {
  
  arquivos_internos <- unzip(
    caminho_zip,
    list = TRUE
  )$Name
  
  
  arquivo_encontrado <- arquivos_internos[
    grepl(
      nome_procurado,
      arquivos_internos,
      fixed = TRUE,
      useBytes = TRUE
    )
  ]
  
  
  if (length(arquivo_encontrado) == 0) {
    
    stop(
      paste0(
        "O arquivo '",
        nome_procurado,
        "' não foi encontrado dentro do ZIP:\n",
        caminho_zip
      )
    )
  }
  
  
  if (length(arquivo_encontrado) > 1) {
    
    warning(
      paste0(
        "Mais de um arquivo foi encontrado para '",
        nome_procurado,
        "'. Será utilizado o primeiro."
      )
    )
  }
  
  
  arquivo_encontrado[1]
}


# ============================================================
# 7. VALIDAR AS COLUNAS DO BANCO
# ============================================================

validar_colunas <- function(
    dados,
    colunas_necessarias,
    ano
) {
  
  colunas_ausentes <- setdiff(
    colunas_necessarias,
    names(dados)
  )
  
  
  if (length(colunas_ausentes) > 0) {
    
    stop(
      paste0(
        "As seguintes colunas estão ausentes no Censo de ",
        ano,
        ":\n",
        paste(
          colunas_ausentes,
          collapse = ", "
        )
      )
    )
  }
}


# ============================================================
# 8. LEITURA DOS CENSOS DE 2007 A 2024
#
# Esses anos possuem um único arquivo consolidado:
# microdados_ed_basica_XXXX.csv
# ============================================================

ler_censo_consolidado <- function(
    caminho_zip,
    ano
) {
  
  message(
    paste0(
      "Lendo o Censo Escolar de ",
      ano,
      "..."
    )
  )
  
  
  nome_arquivo <- paste0(
    "microdados_ed_basica_",
    ano,
    ".csv"
  )
  
  
  arquivo_interno <- localizar_arquivo_zip(
    caminho_zip = caminho_zip,
    nome_procurado = nome_arquivo
  )
  
  
  dados <- read.csv(
    unz(
      caminho_zip,
      arquivo_interno
    ),
    sep = ";",
    fileEncoding = "Latin1",
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  
  validar_colunas(
    dados = dados,
    colunas_necessarias = colunas_consolidado,
    ano = ano
  )
  
  
  dados %>%
    
    select(
      all_of(colunas_consolidado)
    ) %>%
    
    mutate(
      
      CO_ENTIDADE =
        as.character(CO_ENTIDADE),
      
      CO_MUNICIPIO =
        as.character(CO_MUNICIPIO),
      
      TP_DEPENDENCIA =
        as.integer(TP_DEPENDENCIA),
      
      across(
        all_of(colunas_raca),
        ~ as.numeric(.x)
      ),
      
      across(
        all_of(colunas_raca),
        ~ coalesce(.x, 0)
      )
    ) %>%
    
    # Dependência 3 = municipal
    filter(
      CO_MUNICIPIO == id_municipio_vitoria,
      TP_DEPENDENCIA == 3
    ) %>%
    
    mutate(
      Ano = as.integer(ano)
    ) %>%
    
    select(
      Ano,
      CO_ENTIDADE,
      all_of(colunas_raca)
    )
}


# ============================================================
# 9. LEITURA DO CENSO DE 2025
#
# Em 2025, escola e matrícula estão em tabelas separadas.
# ============================================================

ler_censo_2025 <- function(
    caminho_zip
) {
  
  ano <- 2025
  
  
  message(
    "Lendo o Censo Escolar de 2025..."
  )
  
  
  arquivo_escola <- localizar_arquivo_zip(
    caminho_zip = caminho_zip,
    nome_procurado = "Tabela_Escola_2025.csv"
  )
  
  
  arquivo_matricula <- localizar_arquivo_zip(
    caminho_zip = caminho_zip,
    nome_procurado = "Tabela_Matricula_2025.csv"
  )
  
  
  # ----------------------------------------------------------
  # Identificação das escolas municipais de Vitória
  # ----------------------------------------------------------
  
  escolas <- read.csv(
    unz(
      caminho_zip,
      arquivo_escola
    ),
    sep = ";",
    fileEncoding = "Latin1",
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  
  validar_colunas(
    dados = escolas,
    colunas_necessarias = c(
      "CO_ENTIDADE",
      "CO_MUNICIPIO",
      "TP_DEPENDENCIA"
    ),
    ano = ano
  )
  
  
  escolas_vitoria <- escolas %>%
    
    select(
      CO_ENTIDADE,
      CO_MUNICIPIO,
      TP_DEPENDENCIA
    ) %>%
    
    mutate(
      
      CO_ENTIDADE =
        as.character(CO_ENTIDADE),
      
      CO_MUNICIPIO =
        as.character(CO_MUNICIPIO),
      
      TP_DEPENDENCIA =
        as.integer(TP_DEPENDENCIA)
    ) %>%
    
    filter(
      CO_MUNICIPIO == id_municipio_vitoria,
      TP_DEPENDENCIA == 3
    )
  
  
  # ----------------------------------------------------------
  # Quantidades de matrícula por raça/cor
  # ----------------------------------------------------------
  
  matriculas <- read.csv(
    unz(
      caminho_zip,
      arquivo_matricula
    ),
    sep = ";",
    fileEncoding = "Latin1",
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  
  validar_colunas(
    dados = matriculas,
    colunas_necessarias = colunas_matricula_2025,
    ano = ano
  )
  
  
  matriculas %>%
    
    select(
      all_of(colunas_matricula_2025)
    ) %>%
    
    mutate(
      
      CO_ENTIDADE =
        as.character(CO_ENTIDADE),
      
      across(
        all_of(colunas_raca),
        ~ as.numeric(.x)
      ),
      
      across(
        all_of(colunas_raca),
        ~ coalesce(.x, 0)
      )
    ) %>%
    
    inner_join(
      escolas_vitoria,
      by = "CO_ENTIDADE"
    ) %>%
    
    mutate(
      Ano = 2025L
    ) %>%
    
    select(
      Ano,
      CO_ENTIDADE,
      all_of(colunas_raca)
    )
}


