# ============================================================
# 15. CALCULAR A COMPOSIÇÃO RACIAL
# ============================================================

calcular_composicao_racial <- function(
    dados
) {
  
  # ----------------------------------------------------------
  # Soma das matrículas de toda a rede municipal
  # ----------------------------------------------------------
  
  rede <- dados %>%
    
    group_by(
      Ano
    ) %>%
    
    summarise(
      
      Nao_declarada =
        sum(QT_MAT_BAS_ND, na.rm = TRUE),
      
      Branca =
        sum(QT_MAT_BAS_BRANCA, na.rm = TRUE),
      
      Preta =
        sum(QT_MAT_BAS_PRETA, na.rm = TRUE),
      
      Parda =
        sum(QT_MAT_BAS_PARDA, na.rm = TRUE),
      
      Amarela =
        sum(QT_MAT_BAS_AMARELA, na.rm = TRUE),
      
      Indigena =
        sum(QT_MAT_BAS_INDIGENA, na.rm = TRUE),
      
      .groups = "drop"
    ) %>%
    
    mutate(
      Agregado = nome_rede
    )
  
  
  # ----------------------------------------------------------
  # Matrículas apenas da escola Paulo Roberto
  # ----------------------------------------------------------
  
  escola <- dados %>%
    
    filter(
      CO_ENTIDADE == id_escola_paulo
    ) %>%
    
    group_by(
      Ano
    ) %>%
    
    summarise(
      
      Nao_declarada =
        sum(QT_MAT_BAS_ND, na.rm = TRUE),
      
      Branca =
        sum(QT_MAT_BAS_BRANCA, na.rm = TRUE),
      
      Preta =
        sum(QT_MAT_BAS_PRETA, na.rm = TRUE),
      
      Parda =
        sum(QT_MAT_BAS_PARDA, na.rm = TRUE),
      
      Amarela =
        sum(QT_MAT_BAS_AMARELA, na.rm = TRUE),
      
      Indigena =
        sum(QT_MAT_BAS_INDIGENA, na.rm = TRUE),
      
      .groups = "drop"
    ) %>%
    
    mutate(
      Agregado = nome_escola
    )
  
  
  # ----------------------------------------------------------
  # Formato longo e cálculo dos percentuais
  # ----------------------------------------------------------
  
  bind_rows(
    escola,
    rede
  ) %>%
    
    pivot_longer(
      
      cols = c(
        Nao_declarada,
        Branca,
        Preta,
        Parda,
        Amarela,
        Indigena
      ),
      
      names_to = "Raca_cor",
      
      values_to = "Matriculas"
    ) %>%
    
    group_by(
      Ano,
      Agregado
    ) %>%
    
    mutate(
      
      Total_matriculas =
        sum(
          Matriculas,
          na.rm = TRUE
        ),
      
      Percentual =
        if_else(
          
          Total_matriculas > 0,
          
          100 * Matriculas /
            Total_matriculas,
          
          NA_real_
        )
    ) %>%
    
    ungroup() %>%
    
    mutate(
      
      Raca_cor = recode(
        Raca_cor,
        Nao_declarada = "Não declarada",
        Branca = "Branca",
        Preta = "Preta",
        Parda = "Parda",
        Amarela = "Amarela",
        Indigena = "Indígena"
      ),
      
      Raca_cor = factor(
        
        Raca_cor,
        
        levels = c(
          "Branca",
          "Parda",
          "Preta",
          "Amarela",
          "Indígena",
          "Não declarada"
        )
      ),
      
      Percentual =
        round(
          Percentual,
          1
        )
    ) %>%
    
    select(
      Ano,
      Agregado,
      Raca_cor,
      Matriculas,
      Total_matriculas,
      Percentual
    ) %>%
    
    arrange(
      Ano,
      Agregado,
      Raca_cor
    )
}


