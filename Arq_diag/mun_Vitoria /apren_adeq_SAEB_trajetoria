# ============================================================
# 1. FUNÇÃO PARA CALCULAR A APRENDIZAGEM ADEQUADA
# ============================================================

calcular_serie_saeb <- function(tabela, etapa) {
  
  
  # ----------------------------------------------------------
  # 1.1 Pontos de corte da aprendizagem adequada
  # ----------------------------------------------------------
  
  if (etapa == "5º ano") {
    
    corte_lp  <- 200
    corte_mat <- 225
    
  } else if (etapa == "9º ano") {
    
    corte_lp  <- 275
    corte_mat <- 300
    
  } else {
    
    stop(
      "A etapa deve ser informada como '5º ano' ou '9º ano'."
    )
  }
  
  
  # ----------------------------------------------------------
  # 1.2 Construção da consulta SQL
  # ----------------------------------------------------------
  
  consulta <- paste0(
    "
    WITH base_original AS (

      SELECT
        ano,
        sigla_uf,
        disciplina,
        proficiencia_saeb,
        peso_aluno,
        rede,
        escola_publica,


        -- ====================================================
        -- HARMONIZAÇÃO DA VARIÁVEL RAÇA/COR
        -- ====================================================

        CASE

          -- --------------------------------------------------
          -- Até 2015
          --
          -- A = Branco
          -- B = Pardo
          -- C = Preto
          -- D = Amarela
          -- E = Indígena
          -- --------------------------------------------------

          WHEN ano <= 2015
               AND raca_cor = 'A'
            THEN 'Branco'

          WHEN ano <= 2015
               AND raca_cor = 'B'
            THEN 'Pardo'

          WHEN ano <= 2015
               AND raca_cor = 'C'
            THEN 'Preto'

          WHEN ano <= 2015
               AND raca_cor = 'D'
            THEN 'Amarela'

          WHEN ano <= 2015
               AND raca_cor = 'E'
            THEN 'Indígena'


          -- --------------------------------------------------
          -- A partir de 2017
          --
          -- A = Branco
          -- B = Preto
          -- C = Pardo
          -- D = Amarela
          -- E = Indígena
          -- --------------------------------------------------

          WHEN ano >= 2017
               AND raca_cor = 'A'
            THEN 'Branco'

          WHEN ano >= 2017
               AND raca_cor = 'B'
            THEN 'Preto'

          WHEN ano >= 2017
               AND raca_cor = 'C'
            THEN 'Pardo'

          WHEN ano >= 2017
               AND raca_cor = 'D'
            THEN 'Amarela'

          WHEN ano >= 2017
               AND raca_cor = 'E'
            THEN 'Indígena'


          ELSE NULL

        END AS raca_padronizada,


        -- ====================================================
        -- HARMONIZAÇÃO DA IDENTIFICAÇÃO DE ESCOLA PÚBLICA
        -- ====================================================

        CASE

          -- --------------------------------------------------
          -- Até 2019
          --
          -- rede = 1: federal
          -- rede = 2: estadual
          -- rede = 3: municipal
          -- rede = 4: privada
          -- --------------------------------------------------

          WHEN ano <= 2019
               AND SAFE_CAST(rede AS STRING)
                   IN ('1', '2', '3')
            THEN 1


          -- --------------------------------------------------
          -- Em 2021
          --
          -- escola_publica = 1: escola pública
          -- --------------------------------------------------

          WHEN ano = 2021
               AND SAFE_CAST(escola_publica AS STRING) = '1'
            THEN 1


          -- --------------------------------------------------
          -- A partir de 2023
          --
          -- rede = 1: escola pública
          -- rede = 0: escola privada
          -- --------------------------------------------------

          WHEN ano >= 2023
               AND SAFE_CAST(rede AS STRING) = '1'
            THEN 1


          ELSE 0

        END AS escola_publica_padronizada


      FROM `", tabela, "`


      WHERE ano >= 2005
        AND ano <= 2023

        AND disciplina IN ('LP', 'MT')

        AND raca_cor IN ('A', 'B', 'C', 'D', 'E')

        AND proficiencia_saeb IS NOT NULL

        AND peso_aluno IS NOT NULL

        AND peso_aluno > 0
    ),


    -- ========================================================
    -- 2. BASE RESTRITA ÀS ESCOLAS PÚBLICAS
    -- ========================================================

    base_publica AS (

      SELECT
        ano,
        sigla_uf,
        disciplina,
        raca_padronizada AS raca,
        proficiencia_saeb,
        peso_aluno

      FROM base_original

      WHERE escola_publica_padronizada = 1

        AND raca_padronizada IS NOT NULL
    ),


    -- ========================================================
    -- 3. CONSTRUÇÃO DOS AGREGADOS TERRITORIAIS
    -- ========================================================

    territorios AS (

      -- ------------------------------------------------------
      -- Brasil
      -- ------------------------------------------------------

      SELECT
        ano,
        'Brasil' AS agregado,
        disciplina,
        raca,
        proficiencia_saeb,
        peso_aluno

      FROM base_publica


      UNION ALL


      -- ------------------------------------------------------
      -- Espírito Santo
      -- ------------------------------------------------------

      SELECT
        ano,
        'Espírito Santo' AS agregado,
        disciplina,
        raca,
        proficiencia_saeb,
        peso_aluno

      FROM base_publica

      WHERE sigla_uf = 'ES'
    ),


    -- ========================================================
    -- 4. CÁLCULO DA APRENDIZAGEM ADEQUADA
    -- ========================================================

    resultados AS (

      SELECT
        ano,
        agregado,
        disciplina,
        raca,


        SAFE_DIVIDE(

          SUM(

            peso_aluno *

            CASE

              WHEN disciplina = 'LP'
                   AND proficiencia_saeb >= ", corte_lp, "
                THEN 1

              WHEN disciplina = 'MT'
                   AND proficiencia_saeb >= ", corte_mat, "
                THEN 1

              ELSE 0

            END
          ),

          SUM(peso_aluno)

        ) AS aprendizagem_adequada,


        COUNT(*) AS numero_observacoes,


        SUM(peso_aluno) AS soma_pesos


      FROM territorios


      GROUP BY
        ano,
        agregado,
        disciplina,
        raca
    )


    -- ========================================================
    -- 5. RESULTADO FINAL DA CONSULTA
    -- ========================================================

    SELECT
      ano,
      agregado,
      disciplina,
      raca,
      aprendizagem_adequada,
      numero_observacoes,
      soma_pesos

    FROM resultados

    ORDER BY
      ano,
      disciplina,
      raca,
      agregado
    "
  )
  
  
  # ----------------------------------------------------------
  # 1.3 Executar a consulta no BigQuery
  # ----------------------------------------------------------
  
  resultado <- basedosdados::read_sql(
    consulta
  )
  
  
  # ----------------------------------------------------------
  # 1.4 Organizar os resultados no R
  # ----------------------------------------------------------
  
  resultado %>%
    mutate(
      
      Ano = as.integer(ano),
      
      Etapa = etapa,
      
      Disciplina = case_when(
        disciplina == "LP" ~ "Língua Portuguesa",
        disciplina == "MT" ~ "Matemática",
        TRUE ~ disciplina
      ),
      
      Agregado = factor(
        agregado,
        levels = c(
          "Brasil",
          "Espírito Santo"
        )
      ),
      
      Raca = factor(
        raca,
        levels = c(
          "Branco",
          "Pardo",
          "Preto",
          "Amarela",
          "Indígena"
        )
      ),
      
      # Conversão de proporção para percentual
      Aprendizagem_Adequada = aprendizagem_adequada * 100,
      
      Numero_Observacoes = as.numeric(
        numero_observacoes
      ),
      
      Soma_Pesos = as.numeric(
        soma_pesos
      )
    ) %>%
    
    select(
      Ano,
      Etapa,
      Disciplina,
      Agregado,
      Raca,
      Aprendizagem_Adequada,
      Numero_Observacoes,
      Soma_Pesos
    ) %>%
    
    arrange(
      Ano,
      Disciplina,
      Raca,
      Agregado
    )
}


