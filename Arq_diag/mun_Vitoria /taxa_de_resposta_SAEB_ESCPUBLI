# ============================================================
# 1. FUNÇÃO PARA CALCULAR A DISTRIBUIÇÃO RACIAL
# ============================================================

calcular_trajetoria_racial <- function(tabela, etapa) {
  
  consulta <- paste0(
    "
    WITH base_original AS (

      SELECT
        ano,
        sigla_uf,
        raca_cor,
        peso_aluno,
        rede,
        escola_publica,

        -- ====================================================
        -- PADRONIZAÇÃO DA REDE PÚBLICA AO LONGO DOS ANOS
        -- ====================================================

        CASE

          -- Até 2019:
          -- 1 = federal
          -- 2 = estadual
          -- 3 = municipal
          -- 4 = privada

          WHEN ano <= 2019
               AND CAST(rede AS STRING) IN ('1', '2', '3')
            THEN 1


          -- Em 2021:
          -- escola_publica = 1 identifica escola pública

          WHEN ano = 2021
               AND CAST(escola_publica AS STRING) = '1'
            THEN 1


          -- A partir de 2023:
          -- rede = 1 identifica rede pública

          WHEN ano >= 2023
               AND CAST(rede AS STRING) = '1'
            THEN 1


          ELSE 0

        END AS escola_publica_padronizada

      FROM `", tabela, "`

      WHERE ano >= 2005
        AND peso_aluno IS NOT NULL
        AND peso_aluno > 0
    ),


    base AS (

      SELECT
        ano,
        sigla_uf,

        CASE
          WHEN raca_cor = 'A' THEN 'Branco'
          WHEN raca_cor = 'B' THEN 'Preto'
          WHEN raca_cor = 'C' THEN 'Pardo'
          WHEN raca_cor = 'D' THEN 'Amarela'
          WHEN raca_cor = 'E' THEN 'Indígena'
          ELSE 'ND'
        END AS raca,

        peso_aluno

      FROM base_original

      -- Manter somente estudantes de escolas públicas
      WHERE escola_publica_padronizada = 1
    ),


    territorios AS (

      -- ======================================================
      -- BRASIL
      -- ======================================================

      SELECT
        ano,
        'Brasil' AS agregado,
        raca,
        peso_aluno

      FROM base


      UNION ALL


      -- ======================================================
      -- ESPÍRITO SANTO
      -- ======================================================

      SELECT
        ano,
        'Espírito Santo' AS agregado,
        raca,
        peso_aluno

      FROM base

      WHERE sigla_uf = 'ES'
    ),


    distribuicao_racial AS (

      SELECT
        ano,
        agregado,
        raca,

        COUNT(*) AS numero_observacoes,

        SUM(peso_aluno) AS peso_raca

      FROM territorios

      GROUP BY
        ano,
        agregado,
        raca
    ),


    totais AS (

      SELECT
        ano,
        agregado,

        SUM(peso_raca) AS peso_total

      FROM distribuicao_racial

      GROUP BY
        ano,
        agregado
    )


    SELECT
      d.ano,
      d.agregado,
      d.raca,
      d.numero_observacoes,
      d.peso_raca,
      t.peso_total,

      SAFE_DIVIDE(
        d.peso_raca,
        t.peso_total
      ) * 100 AS percentual_estudantes

    FROM distribuicao_racial AS d

    LEFT JOIN totais AS t
      ON d.ano = t.ano
      AND d.agregado = t.agregado

    ORDER BY
      d.ano,
      d.agregado,
      d.raca
    "
  )
  
  
  # Executar a consulta
  resultado <- basedosdados::read_sql(consulta)
  
  
  # Organizar o resultado no R
  resultado %>%
    mutate(
      
      Ano = as.integer(ano),
      
      Etapa = etapa,
      
      Agregado = agregado,
      
      Raca = factor(
        raca,
        levels = c(
          "Branco",
          "Pardo",
          "Preto",
          "Amarela",
          "Indígena",
          "ND"
        )
      ),
      
      Percentual_Estudantes = round(
        percentual_estudantes,
        digits = 1
      ),
      
      Peso_Raca = peso_raca,
      
      Peso_Total = peso_total,
      
      Numero_Observacoes = numero_observacoes
    ) %>%
    
    select(
      Ano,
      Etapa,
      Agregado,
      Raca,
      Percentual_Estudantes,
      Peso_Raca,
      Peso_Total,
      Numero_Observacoes
    ) %>%
    
    arrange(
      Ano,
      factor(
        Agregado,
        levels = c(
          "Brasil",
          "Espírito Santo"
        )
      ),
      Raca
    )
}


# ============================================================
# 2. TRAJETÓRIA RACIAL — 5º ANO
# ============================================================

resultado_raca_5ano <- calcular_trajetoria_racial(
  tabela = "basedosdados.br_inep_saeb.aluno_ef_5ano",
  etapa = "5º ano"
)


tabela_5ano_excel <- resultado_raca_5ano %>%
  select(
    Agregado,
    Raca,
    Ano,
    Percentual_Estudantes
  ) %>%
  
  pivot_wider(
    names_from = Ano,
    values_from = Percentual_Estudantes
  ) %>%
  
  arrange(
    factor(
      Agregado,
      levels = c(
        "Brasil",
        "Espírito Santo"
      )
    ),
    Raca
  )


