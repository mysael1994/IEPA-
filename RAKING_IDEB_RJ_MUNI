# Abrindo base 5 ano EF e Selecionando apenas VI´toria e rede municipal #
IDEB <- basedosdados::read_sql('SELECT * FROM `basedosdados.br_inep_ideb.escola` WHERE ano =2023')
colnames(IDEB)

IDEB_RJ <- IDEB %>%
  filter(sigla_uf == "RJ")

unique(IDEB_RJ$ensino)
unique(IDEB_RJ$anos_escolares)

table(IDEB_RJ$anos_escolares, useNA = "ifany")


IDEB_RJ_EF <- IDEB %>%
  filter(
    sigla_uf == "RJ",
    ensino == "fundamental",
    anos_escolares %in% c(
      "iniciais (1-5)",
      "finais (6-9)"
    )
  )

table(IDEB_RJ_EF$anos_escolares)

IDEB_RJ_EF %>%
  summarise(
    observacoes = n(),
    escolas = n_distinct(id_escola),
    municipios = n_distinct(id_municipio)
  )

#RANKING ANOS INICIAIS
ranking_ideb_iniciais <- IDEB_RJ_EF %>%
  
  filter(
    anos_escolares == "iniciais (1-5)",
    !is.na(ideb)
  ) %>%
  
  group_by(id_municipio) %>%
  
  summarise(
    numero_escolas = n_distinct(id_escola),
    
    ideb_medio = mean(
      ideb,
      na.rm = TRUE
    ),
    
    ideb_mediano = median(
      ideb,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  
  mutate(
    ranking = rank(
      -ideb_medio,
      ties.method = "min"
    )
  ) %>%
  
  arrange(ranking)

print(ranking_ideb_iniciais, n = Inf)

