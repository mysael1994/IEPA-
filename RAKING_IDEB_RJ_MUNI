IDEB_RJ_EM <- IDEB %>%
  filter(
    sigla_uf == "RJ",
    ensino == "medio"
  )

# Diagnóstico
IDEB_RJ_EM %>%
  summarise(
    observacoes = n(),
    escolas = n_distinct(id_escola),
    municipios = n_distinct(id_municipio),
    ideb_validos = sum(!is.na(ideb))
  )

# ============================================================
# RANKING IDEB - ENSINO MÉDIO
# ============================================================

ranking_ideb_medio <- IDEB_RJ_EM %>%
  
  filter(
    !is.na(ideb),
    !is.na(id_municipio)
  ) %>%
  
  group_by(id_municipio) %>%
  
  summarise(
    
    numero_escolas = n_distinct(id_escola),
    
    ideb_medio = mean(
      ideb,
      na.rm = TRUE
    ),
    
    ideb_mediano = median(
      ideb,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  
  mutate(
    ranking = rank(
      -ideb_medio,
      ties.method = "min"
    )
  ) %>%
  
  arrange(ranking)

print(
  ranking_ideb_medio,
  n = Inf
)
