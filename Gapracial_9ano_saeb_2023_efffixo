  select(
    sigla_uf,
    disciplina,
    raca,
    n,
    proficiencia_media
  ) %>%
  
  pivot_wider(
    names_from = raca,
    values_from = c(n, proficiencia_media)
  ) %>%
  
  mutate(
    
    # Gap em pontos na escala SAEB
    gap_racial = proficiencia_media_Branco -
      proficiencia_media_Negro,
    
    # Gap percentual em relação à média dos brancos
    gap_percentual =
