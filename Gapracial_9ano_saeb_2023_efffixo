# ============================================================
# 3. GAP RACIAL BRUTO POR UF
# ============================================================

media_racial_uf <- Saeb_9EF %>%
  
  filter(
    raca %in% c("Branco", "Negro"),
    !is.na(proficiencia_saeb),
    !is.na(peso_aluno)
  ) %>%
  
  group_by(sigla_uf, disciplina, raca) %>%
  
  summarise(
    n = n(),
    
    proficiencia_media = weighted.mean(
      proficiencia_saeb,
      peso_aluno,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  )

media_racial_uf


