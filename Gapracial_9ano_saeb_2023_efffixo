base_gap_escola <- Saeb_9EF %>%
  
  filter(
    raca %in% c("Branco", "Negro"),
    !is.na(proficiencia_saeb),
    !is.na(peso_aluno),
    !is.na(id_escola)
  ) %>%
  
  # Manter apenas escola/disciplinas com negros e brancos
  group_by(sigla_uf, id_escola, disciplina) %>%
  filter(n_distinct(raca) == 2) %>%
  ungroup()


# Diagnóstico da amostra intrasescola

base_gap_escola %>%
  summarise(
    observacoes = n(),
    escolas = n_distinct(id_escola),
    estados = n_distinct(sigla_uf)
  )

base_gap_escola %>%
  count(sigla_uf, disciplina, raca) %>%
  print(n = 108)


# ============================================================
# 6. FUNÇÃO PARA ESTIMAR O GAP INTRASESCOLA
# ============================================================

estimar_gap_escola <- function(uf, disc) {
  
  dados <- base_gap_escola %>%
    filter(
      sigla_uf == uf,
      disciplina == disc
    ) %>%
    mutate(
      negro = ifelse(raca == "Negro", 1, 0)
    )
  
  modelo <- feols(
    proficiencia_saeb ~ negro | id_escola,
    weights = ~peso_aluno,
    cluster = ~id_escola,
    data = dados
  )
  
  beta <- coef(modelo)["negro"]
  ep <- se(modelo)["negro"]
  pvalor <- pvalue(modelo)["negro"]
  
  data.frame(
    sigla_uf = uf,
    disciplina = disc,
    gap_intrasescola = -beta,
    erro_padrao = ep,
    ic_inferior = -beta - 1.96 * ep,
    ic_superior = -beta + 1.96 * ep,
    p_valor = pvalor,
    n = nobs(modelo),
    escolas = n_distinct(dados$id_escola)
  )
}


# ============================================================
# 7. RODANDO PARA AS 27 UFs E DUAS DISCIPLINAS
# ============================================================

combinacoes <- expand.grid(
  sigla_uf = sort(unique(base_gap_escola$sigla_uf)),
  disciplina = c("LP", "MT"),
  stringsAsFactors = FALSE
)

gap_intrasescola <- map2_dfr(
  combinacoes$sigla_uf,
  combinacoes$disciplina,
  estimar_gap_escola
)

gap_intrasescola <- as_tibble(gap_intrasescola)

