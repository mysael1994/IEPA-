  arrange(
    ranking_reducao_intra
  )


# ============================================================
# 28. RANKING DA TRAJETÓRIA - MT
# ============================================================

ranking_trajetoria_MT <- trajetoria_MT %>%
  
  mutate(
    
    ranking_reducao_bruto =
      rank(
        variacao_2015_2023,
        ties.method = "min"
      ),
    
    
    ranking_reducao_intra =
      rank(
        variacao_intra_2015_2023,
        ties.method = "min"
      )
