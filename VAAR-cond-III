#0.3.1 - Função para carregar os dados do Saeb disponíveis no site do Inep:
le.saeb <- function(caminho) {
  read.csv(caminho,  sep = ";", dec = ".", fileEncoding = "latin1", header = TRUE, stringsAsFactors = FALSE)
}

#0.3.2 - Função para arredondar os valores para 6 casas decimais; 
round_6 <- function(var) {
  # Verifica se a variável é numérica ou pode ser convertida para numérica
  var <- as.numeric(var)
  # Arredonda para 6 casas decimais se não for missing
  var <- ifelse(is.na(var), NA, as.numeric(sprintf("%.6f", round(var, 6))))
  return(var)
}

#0.3.3 - Função para calcular a proporção de alunos com desempenho adequado, ponderada pelo peso do aluno
prop_pond <- function(adequado, peso) {
  round_6(sum(adequado * peso, na.rm = TRUE) / sum(peso, na.rm = TRUE))
}


