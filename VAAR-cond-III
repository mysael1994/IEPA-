#3 - Calcula o indicador de proporção de PPI com desempenho inadequado

#3.1 - Cria lista vazia para receber os arquivos do loop
IDppi <- list()

#3.2 - Calcula a proporção de PPI com desempenho inadequado
# Inicia o loop, para calcular o indicador para ambos os anos:
for (ano in anos) {
  # Obtém o nome das variáveis da tabela de cada ano
  input_var <- get(paste0("SAEB_REDUZIDO_", ano))
  # Inicializa as variáveis em uma nova nova tabela
  IDppi[[as.character(ano)]] <- input_var %>% 
    #Seleciona apenas os estudantes que são PPI
    filter(ppi==1) %>% 
    group_by(co_ente) %>% #agrupa por co_ente
    summarise(#Reduz a base apenas as variáveis abaixo, agrupadas por co_ente
      #Proporção de estudantes com desempenho inadequado em português
      p_adeq_lp = prop_pond(adequado_lp, peso_aluno),
      #Proporção de estudantes com desempenho inadequado em matemática
      p_adeq_mt = prop_pond(adequado_mt, peso_aluno),
      #Conta a quantidade de estudantes ppi por ente
      n_estudantes_ppi = n()) %>%
    ungroup() %>% 
    # calcula a media da proporção de estudantes ppi com desempenho inadequado em portugues e matematica
    mutate(
      p_adeq_ppi = case_when(
        n_estudantes_ppi < 10 ~ NA_real_, #Imputa missing quando o municipio tem menos de 10 alunos ppi
        T ~ round_6((p_adeq_lp + p_adeq_mt) / 2))) %>%
    # Adiciona o sufixo do ano a todas as colunas, exceto co_ente
    rename_with(~ paste0(.x, "_", ano), -co_ente)  
}

#3.3 Realiza a junção dos dados de 2019 e 2023, e calcula o indicador
#da diferença entre a proporção de ambos os anos
IDppi_2019_2023 <- reduce(IDppi, full_join, by = "co_ente") %>% 
  mutate(id_ppi = p_adeq_ppi_2023 - p_adeq_ppi_2019)


#4 - Calcula o indicador de proporção de estudantes de NSE baixo com desempenho inadequado

#4.1 - Cria lista vazia para receber os arquivos do loop
IDnse <- list()

#4.2 - Calcula a proporção de PPI com desempenho inadequado
# Inicia o loop, para calcular o indicador para ambos os anos:
for (ano in anos) {
  # Obtém o nome das variáveis da tabela de cada ano
  input_var <- get(paste0("SAEB_REDUZIDO_", ano))
  # Inicializa as variáveis em uma nova nova tabela
  IDnse[[as.character(ano)]] <- input_var %>% 
    #Seleciona apenas os estudantes que têm informação de NSE válida:
    filter(!is.na(nse_grupo)) %>%
    #Conta número de estudantes com informação de NSE válida por co_ente:
    group_by(co_ente) %>%
    mutate(n_estudantes_nse = n()) %>%
    ungroup() %>%
    #Seleciona apenas os estudantes que são de baixo nível socioeconômico
    filter(nse_grupo==1) %>%
    group_by(co_ente) %>% #agrupa por co_ente
    mutate(
      #Conta o número de estudantes com NSE baixo;
      n_estudantes_nsebaixo = n(),
    ) %>%
    summarise(#Reduz a base apenas as variáveis abaixo, agrupadas por co_ente
      n_estudantes_nse = min(n_estudantes_nse),
      n_estudantes_nsebaixo = min(n_estudantes_nsebaixo),
      #Proporção de estudantes com desempenho inadequado em português
      p_adeq_lp = prop_pond(adequado_lp, peso_aluno),
      #Proporção de estudantes com desempenho inadequado em matemática
      p_adeq_mt = prop_pond(adequado_mt, peso_aluno),
      #Conta a quantidade de estudantes de baixo nse por ente
      n_estudantes_nsebaixo = n()) %>%
    ungroup() %>% 
    # calcula a media da proporção de estudantes de baixo nse com desempenho inadequado em portugues e matematica
    mutate(
      p_adeq_nse = case_when(
        n_estudantes_nse < 20 ~ NA_real_, #Imputa missing quando o municipio tem menos de 10 alunos em cada grupo nse
        T ~ round_6((p_adeq_lp + p_adeq_mt) / 2))) %>%
    # Adiciona o sufixo do ano a todas as colunas, exceto co_ente
    rename_with(~ paste0(.x, "_", ano), -co_ente)  
}

#4.3 Realiza a junção dos dados de 2019 e 2023, e calcula o indicador
#da diferença entre a proporção de ambos os anos
IDnse_2019_2023 <- reduce(IDnse, full_join, by = "co_ente") %>% 
  mutate(id_nse = p_adeq_nse_2023 - p_adeq_nse_2019)

#4.4 - Remove objetos grandes que não serão mais utilizados
rm(IDnse, IDppi, input_var)

#5 - Calcula o indicador da Condicionalidade III:
COND3 <- tabela_entes %>% #parte da tabela de todos os entes
  full_join(IDppi_2019_2023, by = "co_ente")  %>% #Une a tabela com o IDppi e a tabela com o IDnse, e com tabelas de total de estudante por co_ente
  full_join(IDnse_2019_2023, by = "co_ente") %>%
  full_join(TOTAL_ESTUDANTES_2019, by = "co_ente") %>%
  full_join(TOTAL_ESTUDANTES_2023, by = "co_ente") %>%
  #Seleciona apenas as variáveis nessárias
  select(-starts_with(c("p_adeq_lp", "p_adeq_mt"))) %>% 
  #Calcula a média dos estudantes entre 2019 e 2023, para computo das margens de erro:
  mutate(media_estudantes_2019_2023 = (total_estudantes_2019+total_estudantes_2023)/2) %>%
  #Calcula a média dos estudantes entre 2019 e 2023, para computo das margens de erro:
  mutate(id_nse_me = 
           case_when(
             media_estudantes_2019_2023 > 10000 & id_nse >= -0.01 & id_nse < 0 ~ 0,
             media_estudantes_2019_2023 > 1000 & media_estudantes_2019_2023 <= 10000 & id_nse >= -0.025 & id_nse < 0 ~ 0,
             media_estudantes_2019_2023 > 500 & media_estudantes_2019_2023 <= 1000 & id_nse >= -0.05 & id_nse < 0 ~ 0,
             media_estudantes_2019_2023 > 200 & media_estudantes_2019_2023 <= 500 & id_nse >= -0.075 & id_nse < 0 ~ 0,
             media_estudantes_2019_2023 > 100 & media_estudantes_2019_2023 <= 200 & id_nse >= -0.1 & id_nse < 0 ~ 0,
             media_estudantes_2019_2023 <= 100 & id_nse >= -0.15 & id_nse < 0 ~ 0,
             T ~ id_nse),
         id_ppi_me = 
           case_when(
             media_estudantes_2019_2023 > 10000 & id_ppi >= -0.01 & id_ppi < 0 ~ 0,
             media_estudantes_2019_2023 > 1000 & media_estudantes_2019_2023 <= 10000 & id_ppi >= -0.025 & id_ppi < 0 ~ 0,
             media_estudantes_2019_2023 > 500 & media_estudantes_2019_2023 <= 1000 & id_ppi >= -0.05 & id_ppi < 0 ~ 0,
             media_estudantes_2019_2023 > 200 & media_estudantes_2019_2023 <= 500 & id_ppi >= -0.075 & id_ppi < 0 ~ 0,
             media_estudantes_2019_2023 > 100 & media_estudantes_2019_2023 <= 200 & id_ppi >= -0.1 & id_ppi < 0 ~ 0,
             media_estudantes_2019_2023 <= 100 & id_ppi >= -0.15 & id_ppi < 0 ~ 0, 
             T ~ id_ppi)
  ) %>%
  #inclui teto
  mutate(id_nse_ajustado = 
           case_when(
             p_adeq_nse_2019 >= 0.9 & p_adeq_nse_2023 >= 0.9 & id_nse_me < 0 ~ 0,
             T ~ id_nse_me),
         id_ppi_ajustado = 
           case_when(
             p_adeq_ppi_2019 >= 0.9 & p_adeq_ppi_2023 >= 0.9 & id_ppi_me < 0 ~ 0,
             T ~ id_ppi_me)) %>%
  #inclui dummy para identificar efeito teto
  mutate(
    teto_nse = ifelse(id_nse_ajustado != id_nse_me, 1, 0),
    teto_ppi = ifelse(id_ppi_ajustado != id_ppi_me, 1, 0)
  ) %>%
  #Quando tem menos de 20 estudantes com informação de NSE válida, considera que tem menos de 10 no grupo de NSE baixo
  mutate(n_estudantes_nsebaixo_2019 = case_when(
    n_estudantes_nse_2019 >= 20 ~ as.character(n_estudantes_nsebaixo_2019),
    is.na(total_estudantes_2019) ~ NA_character_,
    T ~ "Menos de 10 estudantes"),
    n_estudantes_nsebaixo_2023 = case_when(
      n_estudantes_nse_2023 >= 20 ~ as.character(n_estudantes_nsebaixo_2023),
      is.na(total_estudantes_2023) ~ NA_character_,
      T ~ "Menos de 10 estudantes")) %>%
  #Cria variávei indicadora de habilitação na Condicionalidade III
  mutate(habilitado_cond3 = 
           case_when(
             is.na(id_ppi_ajustado) & is.na(id_nse_ajustado) ~ 1, # se ambos idnse e idppi são missing
             is.na(id_ppi_ajustado) & id_nse_ajustado >= 0 ~ 1, # se id_ppi é missing e id_nse não é negativo
             is.na(id_nse_ajustado) & id_ppi_ajustado >= 0 ~ 1, # se id_nse é missing e id_ppi não é negativo
             id_nse_ajustado >= 0 & id_ppi_ajustado >= 0 ~ 1, # se ambos idnse e idppi não são negativos
             T ~ 0
           ))

