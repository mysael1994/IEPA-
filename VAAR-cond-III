#2.1 Salva os dados do Saeb em uma lista para realizar um loop e tratar as duas edições do Saeb em um único código
anos <- c(2019, 2023)
dados <- list(SAEB_2019, SAEB_2023)

#2.2 - Codifica as variáveis e reduz as tabelas originais às variáveis necessárias
for (i in seq_along(anos)) {
  ano <- anos[i]  
  SAEB <- dados[[i]]
  # Cria tabela com proficiência por estudante
  SAEB_REDUZIDO <- SAEB %>%
    mutate(
      # Cria variável indicadora dos estudantes com desempenho inadequado em português
      adequado_lp = case_when(
        proficiencia_lp_saeb > 200 & id_serie == 5 ~ 1,
        proficiencia_lp_saeb > 275 & id_serie == 9 ~ 1,
        proficiencia_lp_saeb > 300 & id_serie %in% c(12, 13) ~ 1,
        TRUE ~ 0),
      # Cria variável indicadora dos estudantes com desempenho inadequado em matemática
      adequado_mt = case_when(
        proficiencia_mt_saeb > 225 & id_serie == 5 ~ 1,
        proficiencia_mt_saeb > 300 & id_serie == 9 ~ 1,
        proficiencia_mt_saeb > 350 & id_serie %in% c(12, 13) ~ 1,
        TRUE ~ 0)) %>%
    # Seleciona apenas variáveis necessárias ao cálculo da Condicionalidade III
    select(co_ente, id_saeb, peso_aluno, adequado_lp, adequado_mt, ppi, nse_grupo)
  
  # Cria os dataframes para cada ano
  assign(paste0("SAEB_REDUZIDO_", ano), SAEB_REDUZIDO)
  
  #Cria tabela com o total de estudantes no SAEB, por ente:
  TOTAL_ESTUDANTES <- SAEB %>% 
    group_by(co_ente) %>%
    summarise(total_estudantes = n()) %>%
    ungroup() %>%
    # Adiciona o sufixo do ano a todas as colunas, exceto co_ente
    rename_with(~ paste0(.x, "_", ano), -co_ente)
  
  # Cria os dataframes para cada ano
  assign(paste0("TOTAL_ESTUDANTES_", ano), TOTAL_ESTUDANTES)
}

