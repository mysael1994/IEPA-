# ============================================================
# 10. BASE PARA O GAP RACIAL INTRASESCOLA
# ============================================================

base_gap_escola <- Saeb_3EM %>%
  
  filter(
    raca %in% c("Branco", "Negro"),
    !is.na(proficiencia_saeb),
    !is.na(peso_aluno),
    !is.na(id_escola)
  ) %>%
  
  # Manter apenas escolas que possuem
  # estudantes brancos e negros
  # na mesma disciplina
  group_by(
    sigla_uf,
    id_escola,
    disciplina
  ) %>%
  
  filter(
    n_distinct(raca) == 2
  ) %>%
  
  ungroup()


