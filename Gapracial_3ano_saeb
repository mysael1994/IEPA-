# ============================================================
# 17. COMPARANDO GAP BRUTO E GAP INTRASESCOLA
# ============================================================

comparacao_gap <- tabela_gap_uf %>%
  
  select(
    sigla_uf,
    gap_racial_LP,
    gap_racial_MT
  ) %>%
  
  left_join(
    gap_intrasescola_uf,
    by = "sigla_uf"
  ) %>%
  
  mutate(
    
    # Redução absoluta
    reducao_LP =
      gap_racial_LP -
      gap_intrasescola_LP,
    
    reducao_MT =
      gap_racial_MT -
      gap_intrasescola_MT,
    
    
    # Redução percentual
    reducao_percentual_LP =
      100 *
      reducao_LP /
      gap_racial_LP,
    
    reducao_percentual_MT =
      100 *
      reducao_MT /
      gap_racial_MT,
    
    
    # Rankings do gap bruto
    ranking_bruto_LP =
      rank(
        -gap_racial_LP,
        ties.method = "min"
      ),
    
    ranking_bruto_MT =
      rank(
        -gap_racial_MT,
        ties.method = "min"
      ),
    
    
    # Rankings do gap intrasescola
    ranking_intrasescola_LP =
      rank(
        -gap_intrasescola_LP,
        ties.method = "min"
      ),
    
    ranking_intrasescola_MT =
      rank(
        -gap_intrasescola_MT,
        ties.method = "min"
      ),
    
    
    # Significância estatística - LP
    significancia_LP_intra =
      case_when(
        
        p_valor_LP < 0.01 ~
          "Sim (p < 0,01)",
        
        p_valor_LP < 0.05 ~
          "Sim (p < 0,05)",
        
        TRUE ~
          "Não"
      ),
    
    
    # Significância estatística - MT
    significancia_MT_intra =
      case_when(
        
        p_valor_MT < 0.01 ~
          "Sim (p < 0,01)",
        
        p_valor_MT < 0.05 ~
          "Sim (p < 0,05)",
        
        TRUE ~
          "Não"
      )
  )


