# ============================================================
# 12. FUNÇÃO PARA ESTIMAR O GAP INTRASESCOLA
# ============================================================

estimar_gap_escola <- function(uf, disc) {
  
  dados <- base_gap_escola %>%
    filter(
      sigla_uf == uf,
      disciplina == disc
    ) %>%
    
    mutate(
      negro =
        ifelse(
          raca == "Negro",
          1,
          0
        )
    )
  
  
  modelo <- feols(
    
    proficiencia_saeb ~ negro |
      id_escola,
    
    weights = ~peso_aluno,
    
    cluster = ~id_escola,
    
    data = dados
  )
  
  
  beta <- coef(modelo)["negro"]
  
  ep <- se(modelo)["negro"]
  
  pvalor <- pvalue(modelo)["negro"]
  
  
  data.frame(
    
    sigla_uf = uf,
    
    disciplina = disc,
    
    # Mantendo a interpretação:
    # Branco - Negro
    gap_intrasescola = -beta,
    
    erro_padrao = ep,
    
    ic_inferior =
      -beta - 1.96 * ep,
    
    ic_superior =
      -beta + 1.96 * ep,
    
    p_valor = pvalor,
    
    n = nobs(modelo),
    
    escolas =
      n_distinct(
        dados$id_escola
      )
  )
}


