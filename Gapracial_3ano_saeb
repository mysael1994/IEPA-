      raca_cor == "E" ~ "Indígena",
      TRUE ~ "ND"
    )
  )


# ============================================================
# 5. GAP RACIAL BRUTO POR UF
# ============================================================

media_racial_uf <- Saeb_3EM %>%
  
  filter(
    raca %in% c("Branco", "Negro"),
    !is.na(proficiencia_saeb),
    !is.na(peso_aluno)
  ) %>%
  
  group_by(sigla_uf, disciplina, raca) %>%
  
  summarise(
    n = n(),
    
    proficiencia_media = weighted.mean(
      proficiencia_saeb,
      peso_aluno,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  )

media_racial_uf


# ============================================================
# 6. TRANSFORMANDO NEGROS E BRANCOS EM COLUNAS
# ============================================================

gap_racial_uf <- media_racial_uf %>%
  
  select(
    sigla_uf,
    disciplina,
    raca,
    n,
    proficiencia_media
  ) %>%
  
  pivot_wider(
    names_from = raca,
    values_from = c(
      n,
      proficiencia_media
    )
  )


# ============================================================
# 7. CALCULANDO O GAP RACIAL
# ============================================================

gap_racial_uf <- gap_racial_uf %>%
  mutate(
    
    # Gap em pontos na escala SAEB
    gap_racial =
      proficiencia_media_Branco -
      proficiencia_media_Negro,
    
    # Gap percentual em relação à média dos brancos
    gap_percentual =
      (gap_racial /
         proficiencia_media_Branco) * 100
  )


